<launch>
  <node pkg="ego_trajectory_udp" type="ego_trajectory_udp_node" name="ego_trajectory_udp_node" output="screen">
    
    <param name="trajectory" value="right_turn"/> 
    
    <param name="ego_x" value="0.0"/>
    <param name="ego_y" value="5.0"/>
    <param name="ego_heading" value="-90.0"/>
    
    <param name="trajectory_length" value="100.0"/>
    <param name="speed" value="3.0"/>
    <param name="udp_ip" value="127.0.0.1"/>
    <param name="udp_port" value="5005"/>
    <param name="rate_hz" value="10.0"/>
    <param name="point_num" value="80"/>
  </node>

  <node pkg="ego_trajectory_udp" type="ego_trajectory_visualizer_node" name="ego_trajectory_visualizer_node" output="screen"/>
</launch>